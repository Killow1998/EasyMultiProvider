{
  "source": "EasyMultiProvider 0.11.6 easy_multi_provider.config._canonicalize_private_paths",
  "status": "implemented",
  "implementation": "crates/emp-state/src/config.rs and crates/emp-state/src/accounts.rs",
  "test": "crates/emp-state/tests/private_path_compat.rs",
  "limitations": [
    "symlink cases run only on platforms where the test creates POSIX links"
  ],
  "cases": [
    {
      "name": "relative-managed-paths",
      "platform": "all",
      "config_path": "nested/config.json",
      "config": {
        "account_store_path": "accounts",
        "secret_store_path": "secrets",
        "accounts": [
          {
            "id": "egg",
            "prefix": "sub",
            "auth_file": "accounts/egg/auth.json.enc"
          }
        ],
        "providers": [
          {
            "id": "deepseek",
            "base_url": "https://api.deepseek.com/v1",
            "api_key_file": "secrets/deepseek.key.enc"
          }
        ]
      },
      "expected": {
        "account_root_relative": "nested/accounts/egg/auth.json.enc",
        "provider_root_relative": "nested/secrets/deepseek.key.enc"
      }
    },
    {
      "name": "tilde-managed-paths",
      "platform": "all",
      "config_path": "nested/config.json",
      "config": {
        "account_store_path": "~/.emp-rust-contract/accounts",
        "secret_store_path": "~/.emp-rust-contract/secrets",
        "accounts": [
          {
            "id": "egg",
            "prefix": "sub",
            "auth_file": "~/.emp-rust-contract/accounts/egg/auth.json.enc"
          }
        ],
        "providers": [
          {
            "id": "deepseek",
            "base_url": "https://api.deepseek.com/v1",
            "api_key_file": "~/.emp-rust-contract/secrets/deepseek.key.enc"
          }
        ]
      },
      "expected": {
        "account_home_relative": ".emp-rust-contract/accounts/egg/auth.json.enc",
        "provider_home_relative": ".emp-rust-contract/secrets/deepseek.key.enc"
      }
    },
    {
      "name": "account-path-escape",
      "platform": "all",
      "config_path": "nested/config.json",
      "config": {
        "account_store_path": "accounts",
        "accounts": [
          {
            "id": "egg",
            "prefix": "sub",
            "auth_file": "../outside/auth.json.enc"
          }
        ]
      },
      "expected": {
        "error_type": "ConfigError",
        "error": "account.auth_file must be managed inside the account store"
      }
    },
    {
      "name": "provider-path-escape",
      "platform": "all",
      "config_path": "nested/config.json",
      "config": {
        "secret_store_path": "secrets",
        "providers": [
          {
            "id": "deepseek",
            "base_url": "https://api.deepseek.com/v1",
            "api_key_file": "../outside/deepseek.key.enc"
          }
        ]
      },
      "expected": {
        "error_type": "ConfigError",
        "error": "provider.api_key_file must be managed inside the secret store"
      }
    },
    {
      "name": "account-final-symlink",
      "platform": "unix",
      "config_path": "nested/config.json",
      "config": {
        "account_store_path": "accounts",
        "accounts": [
          {
            "id": "egg",
            "prefix": "sub",
            "auth_file": "accounts/egg/auth.json.enc"
          }
        ]
      },
      "symlink": {
        "link": "nested/accounts/egg/auth.json.enc",
        "target": "outside/auth.json.enc"
      },
      "expected": {
        "error_type": "ConfigError",
        "error": "account.auth_file must be managed inside the account store"
      }
    },
    {
      "name": "provider-final-symlink",
      "platform": "unix",
      "config_path": "nested/config.json",
      "config": {
        "secret_store_path": "secrets",
        "providers": [
          {
            "id": "deepseek",
            "base_url": "https://api.deepseek.com/v1",
            "api_key_file": "secrets/deepseek.key.enc"
          }
        ]
      },
      "symlink": {
        "link": "nested/secrets/deepseek.key.enc",
        "target": "outside/deepseek.key.enc"
      },
      "expected": {
        "error_type": "ConfigError",
        "error": "provider.api_key_file must be managed inside the secret store"
      }
    }
  ]
}
