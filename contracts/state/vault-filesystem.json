{
  "status": "implemented",
  "implementation": "crates/emp-state/src/filesystem.rs",
  "test": "crates/emp-state/tests/filesystem.rs",
  "master_key": {
    "environment_precedence": true,
    "generated_with_os_csprng": true,
    "exclusive_creation": true,
    "unix_directory_mode": "0700",
    "unix_file_mode": "0600",
    "rejects_symlinks": true,
    "never_replaces_invalid_existing_key": true
