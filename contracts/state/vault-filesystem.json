    "unix_file_mode": "0600"
  },
  "transactions": {
    "process_serialized": true,
    "first_snapshot_wins": true,
    "reverse_order_rollback": true,
    "maximum_snapshot_bytes": 67108864,
    "restores_original_mode_on_unix": true,
    "removes_new_files_on_rollback": true
  },
  "remaining_platform_work": [
    "Windows user-restricted ACLs",
    "Windows reparse-point rejection",
    "cross-process Python-compatible file locks"
  ]
}
