    {
      "key": "openrouter",
      "display_name": "OpenRouter",
      "role": [
        "aggregator"
      ],
      "api_base_urls": [
        "https://openrouter.ai/api/v1"
      ],
      "auth_modes": [
        "bearer_api_key"
      ],
      "supported_protocols": [
        "chat_completions",
        "responses",
        "anthropic_messages"
      ],
      "preferred_protocol": "chat_completions",
      "model_list_endpoint": "https://openrouter.ai/api/v1/models",
      "sources": [
        "https://openrouter.ai/docs/quickstart",
        "https://openrouter.ai/docs/api/api-reference/models/get-models",
        "https://openrouter.ai/docs/guides/overview/models",
        "https://openrouter.ai/docs/guides/features/router-metadata",
        "https://openrouter.ai/docs/guides/features/tool-calling",
        "https://openrouter.ai/docs/faq"
      ],
      "reviewed_at": "2026-08-22",
      "notes": "OpenRouter is a live aggregator. It exposes OpenAI Chat Completions, OpenAI Responses, and Anthropic Messages skins over the same base URL. GET /api/v1/models returns rich per-model metadata including supported_parameters (tools, reasoning, structured_outputs, response_format, etc.). Model capabilities are inherited from upstream providers; OpenRouter standardizes the interface. parallel_tool_calls defaults true. reasoning_effort enum: xhigh, high, medium, low, minimal, none."
    },
